# Database
DATABASE_URL=sqlite:///./mat_planner.db

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# LLM
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Embedding (bge-m3 via API)
EMBED_ENABLED=true
EMBED_MODEL=BAAI/bge-m3
EMBED_BATCH_SIZE=32
EMBED_DIM=1024

# LLM-assisted NER (requires LLM_* above)
LLM_NER_ENABLED=true
